---
import { ViewTransitions } from 'astro:transitions';
import { SITE_CONFIG, AVATAR, OG_IMAGE } from '../site';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
  };
}

const { title, description, article } = Astro.props;
const pageTitle = title
  ? `${title} - ${SITE_CONFIG.name}`
  : `${SITE_CONFIG.name} - ${SITE_CONFIG.tagline}`;
const pageDescription = description || SITE_CONFIG.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.name,
  url: Astro.site?.toString(),
  description: SITE_CONFIG.description,
  author: {
    '@type': 'Person',
    name: SITE_CONFIG.author,
    jobTitle: SITE_CONFIG.tagline,
    url: Astro.site?.toString(),
    sameAs: [SITE_CONFIG.social.github, SITE_CONFIG.social.linkedin],
  },
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: pageDescription,
      url: canonicalURL.toString(),
      image: new URL(OG_IMAGE, Astro.site).toString(),
      datePublished: article.publishedTime.toISOString(),
      ...(article.modifiedTime && {
        dateModified: article.modifiedTime.toISOString(),
      }),
      author: {
        '@type': 'Person',
        name: SITE_CONFIG.author,
        url: Astro.site?.toString(),
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
    }
  : null;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.name} href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE_CONFIG.author} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(OG_IMAGE, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    {article && (
      <>
        <meta property="article:author" content={SITE_CONFIG.author} />
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(OG_IMAGE, Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
    {articleSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    )}

    <ViewTransitions />

    <script is:inline>
      function isDarkTheme() {
        var theme = localStorage.getItem('theme');
        return theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      }
      if (isDarkTheme()) document.documentElement.classList.add('dark');
      document.addEventListener('astro:before-swap', function(e) {
        e.newDocument.documentElement.classList.toggle('dark', isDarkTheme());
      });
    </script>
  </head>
  <body class="min-h-screen bg-page text-ink">
    <a href="#main" class="no-underline sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-3 focus:py-1.5 focus:text-sm focus:bg-surface focus:border focus:border-line focus:rounded">Skip to content</a>
    <div class="max-w-3xl mx-auto px-4 py-8 sm:py-20">
      <header class="flex items-center justify-between mb-12 sm:mb-16">
        <nav class="flex items-center gap-5 sm:gap-6 text-base">
          {SITE_CONFIG.nav.map((link) => (
            <a
              href={link.href}
              class:list={[
                'no-underline font-serif transition-colors',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-ink font-medium'
                  : 'text-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <ThemeToggle />
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="mt-16 sm:mt-24 pt-6 border-t border-line flex items-center justify-between text-xs text-muted">
        <span>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}</span>
        <a href="/rss.xml" class="text-muted hover:text-ink no-underline">RSS</a>
      </footer>
    </div>
  </body>
</html>
